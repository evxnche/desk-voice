# desk-voice environment. Copy into Vercel (Project → Settings → Environment Variables), or to .env.local for `vercel dev`.
# Never commit real values: .gitignore ignores every .env* file except this one.

# ── Required for the glasses app (/api/glasses + /api/agent) ──
# Shared secret the iPhone app sends as ?k=. Make one with: openssl rand -hex 24
VOICE_KEY=
# Upstash Redis REST URL for the agent pager; the Vercel Upstash integration sets it for you.
KV_REST_API_URL=
# Upstash Redis REST token; set by the integration too. (UPSTASH_REDIS_REST_URL / _TOKEN also work instead of the KV_ pair.)
KV_REST_API_TOKEN=
# Only needed outside Vercel (or if OIDC is off): on Vercel, AI Gateway authenticates itself with OIDC.
AI_GATEWAY_API_KEY=

# ── Noty notes (glasses: read notes, "note: …", "add X to my tasks") ──
# Your own Noty server's notes endpoint, e.g. https://your-noty.vercel.app/api/notes. No default: unset = notes off.
NOTY_NOTES_URL=
# The NOTY_SYNC_TOKEN of that Noty server (the same 32+ character key).
NOTY_SYNC_TOKEN=

# ── Optional tuning (glasses + board) ──
# Your IANA time zone for clock times, note stamps and the calendar (default Asia/Kolkata).
DESK_TZ=
# The place name said with times, e.g. "New York" (default India).
DESK_PLACE=
# Chat model on AI Gateway (default openai/gpt-oss-120b).
CHAT_MODEL=
# Speech-to-text model (default spacexai/grok-stt; openai/gpt-4o-mini-transcribe is the fixed backup).
STT_MODEL=
# Text-to-speech model (default spacexai/grok-tts).
TTS_MODEL=
# TTS voice (default ara for Grok, alloy for openai/ models).
TTS_VOICE=
# Private iCal (.ics) links, space-separated: adds a calendar tool to the glasses and the Plan screens.
PLAN_CALENDARS=
# JSON endpoint of AI agent usage limits ({providers:[{name, windows:[{label, used, resets}]}]}); unset = no limits.
LIMITS_URL=

# ── Other Desk Pal features (not used by the glasses app) ──
# Key for /api/plan, the Xteink reader's Plan screens.
PLAN_KEY=
# Vision model for /api/look ("what's this error?" from the Mac) (default openai/gpt-5-mini).
VISION_MODEL=
# Spotify app client ID for the board's music control (redirect URI is fixed in lib/spotify.js).
SPOTIFY_CLIENT_ID=
# Spotify app client secret.
SPOTIFY_CLIENT_SECRET=
# FlightAware AeroAPI key for flight tracking timetables (/api/track).
FLIGHTAWARE_KEY=
